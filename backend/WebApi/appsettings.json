{
  "ConnectionStrings": {
    "ReadDatabase": "",
    "WriteDatabase": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{RequestId}] [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "EnableSwagger": true,
  "AutoMigration": true,
  "Security": {
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutMinutes": 60
    },
    "Jwt": {
      "Secret": "",
      "RefreshSecret": "",
      "ExpirationMinutes": 15,
      "RefreshExpirationDays": 30,
      "RefreshShortExpirationDays": 1,
      "Issuer": "Huy Truong",
      "Audience": "http://localhost:5173",
      "ResetPasswordExpirationHours": 1
    },
    "Email": {
      "ChangePasswordNotification": {
        "Subject": "Change password notification"
      },
      "ResetPasswordSuccessNotification": {
        "Subject": "Reset password success notification."
      },
      "ResetPasswordNotification": {
        "Subject": "Reset your password.",
        "Url": "http://localhost:5173/reset-password"
      },
      "EmailVerificationNotification": {
        "Subject": "Verify your email address.",
        "Url": "http://localhost:5173/verify-email"
      }
    }
  },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "dataset",
    "Region": "us-east-1",
    "Secure": false
  },
  "Redis": {
    "Connection": "localhost:6379",
    "InstanceName": "Redis",
    "ConnectRetry": 3,
    "ConnectTimeout": 5000
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "EnableSsl": true,
    "From": ""
  },
  "Asset": {
    "Encryption": {
      "PublicKey": "",
      "PrivateKey": ""
    }
  },
  "Replication": {
    "ReadDelay": 1000
  },
  "Providers": {
    "OpenTripMap": {
      "BaseUrl": "https://api.opentripmap.com/0.1/en/places",
      "ApiKey": ""
    },
    "Foursquare": {
      "BaseUrl": "https://places-api.foursquare.com",
      "ApiKey": "",
      "EnableEnrichment": true
    },
    "Nominatim": {
      "BaseUrl": "https://nominatim.openstreetmap.org"
    },
    "Geocoding": {
      "Provider": "Nominatim"
    },
    "Destination": {
      "Provider": "OpenTripMap"
    }
  },
  "Caching": {
    "Locations": {
      "TtlHours": 1
    },
    "Destinations": {
      "AttractionListTtlMinutes": 30,
      "AttractionDetailTtlHours": 24
    }
  }
}
